{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/witthaya-quant/Open-Finance-Research-Lab/blob/main/schemas/ofrl-project-manifest-1.1.0.schema.json",
  "title": "OFRL Project Manifest",
  "description": "Machine-readable metadata, lifecycle, risk, and release-readiness contract for every registered OFRL project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "lifecycle_status",
    "project_types",
    "risk_tier",
    "owner",
    "created_at",
    "updated_at",
    "summary",
    "evidence_maturity",
    "license_profile",
    "data_classification",
    "validation_profiles",
    "required_documents",
    "release_status",
    "release_readiness"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^OFRL-[A-Z0-9]{2,8}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160
    },
    "lifecycle_status": {
      "enum": [
        "proposed",
        "approved",
        "in_development",
        "validation",
        "released",
        "maintenance",
        "deprecated",
        "archived"
      ]
    },
    "project_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "research",
          "quantitative_research",
          "financial_model",
          "software",
          "data",
          "benchmark",
          "prototype",
          "infrastructure"
        ]
      }
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "evidence_maturity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "license_profile": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "data_classification": {
      "enum": [
        "none",
        "synthetic",
        "public_source",
        "licensed",
        "restricted",
        "mixed"
      ]
    },
    "validation_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "research",
          "quantitative",
          "financial_model",
          "software",
          "data",
          "benchmark",
          "prototype",
          "security",
          "privacy",
          "performance",
          "integration"
        ]
      }
    },
    "required_documents": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
      }
    },
    "release_status": {
      "enum": [
        "not_released",
        "pre_release",
        "released",
        "withdrawn"
      ]
    },
    "repository_url": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^OFRL-[A-Z0-9]{2,8}-[0-9]{3}$"
      }
    },
    "validation_workflows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
      }
    },
    "release_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_version",
        "assessment_status",
        "operational_mode",
        "independent_assurance_required",
        "independent_assurance_rationale",
        "gates",
        "authorization",
        "residual_risk_assessment"
      ],
      "properties": {
        "assessment_version": {
          "const": "1.0.0"
        },
        "assessment_status": {
          "enum": [
            "NOT_ASSESSED",
            "BLOCKED",
            "ELIGIBLE_FOR_AUTHORIZATION"
          ]
        },
        "operational_mode": {
          "enum": [
            "RESEARCH_ONLY",
            "SIMULATION",
            "SANDBOX",
            "LIVE_EXTERNAL"
          ]
        },
        "independent_assurance_required": {
          "type": "boolean"
        },
        "independent_assurance_rationale": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000
        },
        "gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate_id",
              "status",
              "rationale",
              "evidence",
              "recorded_by",
              "recorded_at"
            ],
            "properties": {
              "gate_id": {
                "enum": [
                  "scope_and_claims",
                  "evidence_and_limitations",
                  "data_rights",
                  "licence_and_ip",
                  "reproducibility",
                  "domain_review",
                  "numeric_and_financial_controls",
                  "dependency_and_sbom",
                  "independent_domain_review",
                  "security_review",
                  "privacy_legal_review",
                  "operational_safeguards",
                  "incident_response",
                  "rollback_recovery",
                  "founder_approval",
                  "maintenance_and_corrections"
                ]
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT RUN",
                  "BLOCKED",
                  "NOT APPLICABLE"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 20,
                "maxLength": 2000
              },
              "evidence": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 2048
                }
              },
              "recorded_by": {
                "type": "string",
                "minLength": 2,
                "maxLength": 128
              },
              "recorded_at": {
                "type": "string",
                "format": "date"
              },
              "assessor": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "identity",
                  "role",
                  "independent",
                  "conflict_status",
                  "review_reference"
                ],
                "properties": {
                  "identity": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 128
                  },
                  "role": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 160
                  },
                  "independent": {
                    "type": "boolean"
                  },
                  "review_reference": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 2048
                  },
                  "conflict_status": {
                    "enum": [
                      "NONE_DECLARED",
                      "DISCLOSED"
                    ]
                  },
                  "conflict_rationale": {
                    "type": "string",
                    "minLength": 30,
                    "maxLength": 1000
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "conflict_status": {
                          "const": "DISCLOSED"
                        }
                      },
                      "required": [
                        "conflict_status"
                      ]
                    },
                    "then": {
                      "required": [
                        "conflict_rationale"
                      ],
                      "properties": {
                        "conflict_rationale": {
                          "type": "string"
                        }
                      }
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "PASS"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "required": [
                    "assessor"
                  ],
                  "properties": {
                    "evidence": {
                      "type": "array",
                      "minItems": 1
                    },
                    "assessor": {
                      "type": "object"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "NOT APPLICABLE"
                    }
                  },
                  "required": [
                    "status"
                  ]
                },
                "then": {
                  "properties": {
                    "rationale": {
                      "type": "string",
                      "minLength": 30
                    }
                  }
                }
              }
            ]
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "authority",
            "authority_role",
            "authorized_at",
            "decision_record",
            "source_commit"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_AUTHORIZED",
                "AUTHORIZED",
                "WITHDRAWN"
              ]
            },
            "authority": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2,
              "maxLength": 128
            },
            "authority_role": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 3,
              "maxLength": 160
            },
            "authorized_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "decision_record": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 8,
              "maxLength": 2048
            },
            "source_commit": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "enum": [
                      "AUTHORIZED",
                      "WITHDRAWN"
                    ]
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "authority": {
                    "type": "string"
                  },
                  "authority_role": {
                    "type": "string"
                  },
                  "authorized_at": {
                    "type": "string",
                    "format": "date"
                  },
                  "decision_record": {
                    "type": "string"
                  },
                  "source_commit": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "NOT_AUTHORIZED"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "authority": {
                    "type": "null"
                  },
                  "authority_role": {
                    "type": "null"
                  },
                  "authorized_at": {
                    "type": "null"
                  },
                  "decision_record": {
                    "type": "null"
                  },
                  "source_commit": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "residual_risk_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "outcome",
            "reviewed_by",
            "reviewer_role",
            "reviewed_at",
            "next_review_at",
            "evidence",
            "risks"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_ASSESSED",
                "ASSESSED"
              ]
            },
            "outcome": {
              "enum": [
                "NOT_ASSESSED",
                "NO_RESIDUAL_RISKS",
                "RESIDUAL_RISKS_RECORDED"
              ]
            },
            "reviewed_by": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 2,
              "maxLength": 128
            },
            "reviewer_role": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 3,
              "maxLength": 160
            },
            "reviewed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "next_review_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "evidence": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 8,
                "maxLength": 2048
              }
            },
            "risks": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "risk_id",
                  "summary",
                  "severity",
                  "decision",
                  "control_owner",
                  "review_due_at",
                  "expires_at",
                  "expiry_condition",
                  "rationale",
                  "evidence",
                  "accepted_by",
                  "accepted_by_role",
                  "accepted_at",
                  "decision_reference"
                ],
                "properties": {
                  "risk_id": {
                    "type": "string",
                    "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 1000
                  },
                  "severity": {
                    "enum": [
                      "LOW",
                      "MEDIUM",
                      "HIGH",
                      "CRITICAL"
                    ]
                  },
                  "decision": {
                    "enum": [
                      "OPEN",
                      "MITIGATED",
                      "TRANSFERRED",
                      "ACCEPTED",
                      "CLOSED"
                    ]
                  },
                  "control_owner": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 128
                  },
                  "review_due_at": {
                    "type": "string",
                    "format": "date"
                  },
                  "expires_at": {
                    "type": "string",
                    "format": "date"
                  },
                  "expiry_condition": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 1000
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 2000
                  },
                  "evidence": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 8,
                      "maxLength": 2048
                    }
                  },
                  "accepted_by": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 2,
                    "maxLength": 128
                  },
                  "accepted_by_role": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 3,
                    "maxLength": 160
                  },
                  "accepted_at": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  },
                  "decision_reference": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 8,
                    "maxLength": 2048
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "NOT_ASSESSED"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "outcome": {
                    "const": "NOT_ASSESSED"
                  },
                  "reviewed_by": {
                    "type": "null"
                  },
                  "reviewer_role": {
                    "type": "null"
                  },
                  "reviewed_at": {
                    "type": "null"
                  },
                  "next_review_at": {
                    "type": "null"
                  },
                  "evidence": {
                    "type": "array",
                    "maxItems": 0
                  },
                  "risks": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "ASSESSED"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "outcome": {
                    "enum": [
                      "NO_RESIDUAL_RISKS",
                      "RESIDUAL_RISKS_RECORDED"
                    ]
                  },
                  "reviewed_by": {
                    "type": "string",
                    "minLength": 2
                  },
                  "reviewer_role": {
                    "type": "string",
                    "minLength": 3
                  },
                  "reviewed_at": {
                    "type": "string",
                    "format": "date"
                  },
                  "next_review_at": {
                    "type": "string",
                    "format": "date"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "NO_RESIDUAL_RISKS"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": {
                "properties": {
                  "risks": {
                    "type": "array",
                    "maxItems": 0
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "outcome": {
                    "const": "RESIDUAL_RISKS_RECORDED"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "then": {
                "properties": {
                  "risks": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
