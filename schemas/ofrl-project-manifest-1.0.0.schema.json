{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/witthaya-quant/Open-Finance-Research-Lab/blob/main/schemas/ofrl-project-manifest-1.0.0.schema.json",
  "title": "OFRL Project Manifest",
  "description": "Machine-readable metadata and governance profile for every registered OFRL project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "lifecycle_status",
    "project_types",
    "risk_tier",
    "owner",
    "created_at",
    "updated_at",
    "summary",
    "evidence_maturity",
    "license_profile",
    "data_classification",
    "validation_profiles",
    "required_documents",
    "release_status"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^OFRL-[A-Z0-9]{2,8}-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 160
    },
    "lifecycle_status": {
      "enum": [
        "proposed",
        "approved",
        "in_development",
        "validation",
        "released",
        "maintenance",
        "deprecated",
        "archived"
      ]
    },
    "project_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "research",
          "quantitative_research",
          "financial_model",
          "software",
          "data",
          "benchmark",
          "prototype",
          "infrastructure"
        ]
      }
    },
    "risk_tier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 40,
      "maxLength": 1200
    },
    "evidence_maturity": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "license_profile": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "data_classification": {
      "enum": [
        "none",
        "synthetic",
        "public_source",
        "licensed",
        "restricted",
        "mixed"
      ]
    },
    "validation_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "research",
          "quantitative",
          "financial_model",
          "software",
          "data",
          "benchmark",
          "prototype",
          "security",
          "privacy",
          "performance",
          "integration"
        ]
      }
    },
    "required_documents": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
      }
    },
    "release_status": {
      "enum": [
        "not_released",
        "pre_release",
        "released",
        "withdrawn"
      ]
    },
    "repository_url": {
      "type": "string",
      "format": "uri"
    },
    "version": {
      "type": "string",
      "maxLength": 64
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^OFRL-[A-Z0-9]{2,8}-[0-9]{3}$"
      }
    },
    "validation_workflows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
      }
    }
  }
}
